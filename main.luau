local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local BADGE_NAME = "SupremeValueLabel"

local function normalize(text)
    return text:lower():match("^%s*(.-)%s*$")
end

-- Map names only when unambiguous; several skins share a name.
local index = {}
local function addName(name, item)
    local key = normalize(name)
    local previous = index[key]
    if previous == nil then
        index[key] = item
    elseif previous ~= false and previous ~= item and previous[4] ~= item[4] then
        index[key] = false
    end
end

for _, item in ipairs(items) do
    addName(item[2], item)
    addName(item[3], item)
end

local function update(label)
    if not label:IsA("TextLabel") or label.Name == BADGE_NAME then
        return
    end

    local item = index[normalize(label.Text)]
    local badge = label:FindFirstChild(BADGE_NAME)
    if not item then
        if badge then badge:Destroy() end
        return
    end

    if not badge then
        badge = Instance.new("TextLabel")
        badge.Name = BADGE_NAME
        badge.Position = UDim2.new(0, 2, 0, -22)
        badge.Size = UDim2.new(1, -4, 0, 20)
        badge.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        badge.BackgroundTransparency = 0.2
        badge.BorderSizePixel = 0
        badge.TextColor3 = Color3.fromRGB(255, 220, 90)
        badge.Font = Enum.Font.GothamBold
        badge.TextSize = 12
        badge.TextWrapped = true
        badge.ZIndex = label.ZIndex + 1
        badge.Parent = label
    end
    badge.Text = "Value: " .. item[4]
end

local function watch(object)
    if not object:IsA("TextLabel") or object.Name == BADGE_NAME then return end
    update(object)
    object:GetPropertyChangedSignal("Text"):Connect(function()
        update(object)
    end)
end

for _, object in ipairs(playerGui:GetDescendants()) do watch(object) end
playerGui.DescendantAdded:Connect(watch)

-- TradeGUI.Container.Trade.YourOffer/TheirOffer.Container.NewItem*.ItemName.Label
-- Values are a fixed snapshot; nonnumeric or ambiguous items are not guessed.
local old = playerGui:FindFirstChild("SupremeTradeComparison")
if old then old:Destroy() end
local screen = Instance.new("ScreenGui")
screen.Name = "SupremeTradeComparison"
screen.ResetOnSpawn = false
screen.DisplayOrder = 1000
screen.Parent = playerGui

local panel = Instance.new("TextLabel")
panel.Name = "Summary"
panel.AnchorPoint = Vector2.new(0.5, 0)
panel.Position = UDim2.new(0.5, 0, 0, 8)
panel.Size = UDim2.fromOffset(420, 72)
panel.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
panel.BackgroundTransparency = 0.1
panel.BorderSizePixel = 0
panel.Font = Enum.Font.GothamBold
panel.TextSize = 16
panel.TextWrapped = true
panel.TextStrokeTransparency = 0.2
panel.TextColor3 = Color3.fromRGB(255, 220, 100)
panel.Active = false
panel.Visible = false
panel.Parent = screen

local function visible(object)
    local node = object
    while node and node ~= playerGui do
        if node:IsA("GuiObject") and not node.Visible then return false end
        if node:IsA("ScreenGui") and not node.Enabled then return false end
        node = node.Parent
    end
    return node == playerGui
end

local function findTrade()
    for _, guiName in ipairs({"TradeGUI", "TradeGUI_Phone"}) do
        local root = playerGui:FindFirstChild(guiName)
        local container = root and root:FindFirstChild("Container")
        local trade = container and container:FindFirstChild("Trade")
        if trade and visible(trade) then return trade end
    end
    return nil
end

local function countInCard(card)
    for _, object in ipairs(card:GetDescendants()) do
        if object:IsA("TextLabel") and object.Name ~= BADGE_NAME and visible(object) then
            local text = object.Text:gsub("×", "x")
            local n = text:match("^%s*[xX]%s*(%d+)%s*$")
            if n then return math.max(1, tonumber(n)) end
        end
    end
    return 1
end

local function calculate(offer)
    local container = offer and offer:FindFirstChild("Container")
    if not container then return nil end
    local total, unknown = 0, 0
    for _, card in ipairs(container:GetChildren()) do
        local itemName = card:FindFirstChild("ItemName")
        local label = itemName and itemName:FindFirstChild("Label")
        if label and label:IsA("TextLabel") and visible(label) then
            local name = normalize(label.Text)
            if name ~= "" then
                local item = index[name]
                local raw = item and item[4]
                local value = raw and tonumber((raw:gsub(",", "")))
                if value then total = total + value * countInCard(card)
                else unknown = unknown + 1 end
            end
        end
    end
    return {total = total, unknown = unknown}
end

local function refresh()
    local trade = findTrade()
    if not trade then panel.Visible = false; return end
    panel.Visible = true
    local mine = calculate(trade:FindFirstChild("YourOffer"))
    local theirs = calculate(trade:FindFirstChild("TheirOffer"))
    if not mine or not theirs then
        panel.TextColor3 = Color3.fromRGB(255, 220, 100)
        panel.Text = "Trade: offer containers not found"
        return
    end
    local totals = "YOU: " .. mine.total .. " | THEM: " .. theirs.total
    if mine.unknown > 0 or theirs.unknown > 0 then
        panel.TextColor3 = Color3.fromRGB(255, 220, 100)
        panel.Text = totals .. " (partial)\nUnknown or nonnumeric: " .. (mine.unknown + theirs.unknown) .. " — no WIN/LOSE"
        return
    end
    local delta = theirs.total - mine.total
    if delta > 0 then
        panel.TextColor3 = Color3.fromRGB(110, 255, 145)
        panel.Text = totals .. "\nWIN +" .. delta .. " val"
    elseif delta < 0 then
        panel.TextColor3 = Color3.fromRGB(255, 115, 115)
        panel.Text = totals .. "\nLOSE " .. delta .. " val"
    else
        panel.TextColor3 = Color3.fromRGB(230, 230, 230)
        panel.Text = totals .. "\nFAIR 0 val"
    end
end

task.spawn(function()
    while screen.Parent do
        local ok, err = pcall(refresh)
        if not ok then
            panel.Visible = true
            panel.Text = "Trade calculation error: " .. tostring(err)
            panel.TextColor3 = Color3.fromRGB(255, 130, 130)
        end
        task.wait(0.5)
    end
end)
